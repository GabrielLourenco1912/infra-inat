# Obrigatórias: substitua antes de iniciar os containers.
DB_ROOT_PASSWORD=substitua-por-uma-senha-administrativa-segura
DB_PASSWORD=substitua-por-uma-senha-da-aplicacao-segura
JWT_SECRET=substitua-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_ISSUER=https://sistema.exemplo.com.br
EMAIL=substitua-por-endereco-de-email-automatico
EMAIL_PASS=substitua-por-senha-de-endereco-de-email-automatico
# Origem pública do portal, usada nos e-mails e redirecionamentos do frontend, sem caminho final.
PORTAL_BASE_URL=https://sistema.exemplo.com.br
# Uma ou mais origens exatas, separadas por vírgula e sem barra final.
CORS_ALLOWED_ORIGINS=substitua-por-origem
# Opcionais: os valores abaixo já são os padrões do Docker Compose.
# COMPOSE_PROJECT_NAME=inat-ead
# DB_NAME=inat_ead
# DB_USERNAME=inat_ead
# Backup incluso no Compose: veja docker/mysql-backup/README.md antes do primeiro deploy.
# O banco de origem é DB_NAME; por padrão usa DB_USERNAME e DB_PASSWORD.
# Proteja o .env com chmod 600 e não o versione.
# MYSQL_BACKUP_HOST=mysql
# MYSQL_BACKUP_PORT=3306
# MYSQL_BACKUP_HOST_DIR=/var/backups/inat/mysql
# MYSQL_BACKUP_RETENTION_DAYS=30
# Opcionais: preencha somente para usar uma conta exclusiva para os backups.
# MYSQL_BACKUP_USERNAME=
# MYSQL_BACKUP_PASSWORD=
# Restauração manual: vazios reutilizam host, porta e credenciais do backup.
# MYSQL_RESTORE_HOST=
# MYSQL_RESTORE_PORT=
# MYSQL_RESTORE_USERNAME=
# MYSQL_RESTORE_PASSWORD=
# FRONTEND_PORT=3000
# NODE_VERSION=22
# Opções da JVM aplicadas ao processo Java no container do backend.
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
# URL usada somente pelo servidor Next.js para acessar o backend.
# FRONTEND_BACKEND_URL=http://backend:8080
# Força o atributo Secure no cookie de access token; vazio detecta HTTPS pela requisição.
# FRONTEND_AUTH_COOKIE_SECURE=false
# Em desenvolvimento HTTP, defina false; em produção HTTPS, mantenha true.
# API_SECURITY_REFRESH_COOKIE_SECURE=false
# SPRING_JPA_SHOW_SQL=false
# FILE_STORAGE_MAX_SIZE=25MB
# FILE_STORAGE_MAX_REQUEST_SIZE=26MB
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SSL_ENABLED=true
# SMTP_STARTTLS_ENABLED=false
# SMTP_STARTTLS_REQUIRED=false
# SMTP_CONNECTION_TIMEOUT=5000
# SMTP_READ_TIMEOUT=5000
# SMTP_WRITE_TIMEOUT=5000
# AUTH_CHALLENGE_TTL=10m
# AUTH_CHALLENGE_MAX_ATTEMPTS=5
# AUTH_ACCOUNT_LOCK_MAX_FAILED_ATTEMPTS=5
# AUTH_ACCOUNT_LOCK_DURATION=15m
# AUTH_ACCOUNT_LOCK_SCHEDULER_ENABLED=true
# AUTH_ACCOUNT_UNLOCK_INTERVAL=60000
# NOTIFICATION_EMAIL_ENABLED=true
# NOTIFICATION_EMAIL_DISPATCH_DELAY=5000
# NOTIFICATION_EMAIL_BATCH_SIZE=50
# ACADEMIC_LIFECYCLE_ENABLED=true
# ACADEMIC_LIFECYCLE_INTERVAL=60000
# ACADEMIC_REMINDER_BATCH_SIZE=200
# ACADEMIC_ATTENDANCE_BATCH_SIZE=200
# DOCUMENT_LIFECYCLE_ENABLED=true
# DOCUMENT_LIFECYCLE_INTERVAL=60000
# DOCUMENT_LIFECYCLE_BATCH_SIZE=200
# FILE_ALLOWED_DOCUMENT_EXTENSIONS=pdf,png,jpg,jpeg,webp
# FILE_ALLOWED_ACTIVITY_EXTENSIONS=pdf,png,jpg,jpeg,webp,gif,txt,csv,rtf,docx,xlsx,pptx,odt,ods,odp,mp3,mp4,webm,wav
# FILE_ALLOWED_SUBMISSION_EXTENSIONS=pdf,png,jpg,jpeg,webp,gif,txt,csv,rtf,docx,xlsx,pptx,odt,ods,odp,mp3,mp4,webm,wav
# Habilite somente quando houver um clamd acessível pelo container do backend.
# FILE_ANTIVIRUS_ENABLED=false
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_CONNECT_TIMEOUT=3s
# CLAMAV_READ_TIMEOUT=30s

# URL pública do sistema acessado pelos CTAs da landing page.
# Sem valor, os links continuam apontando para a seção local.
# NEXT_PUBLIC_INTERNAL_SYSTEM_URL=https://sistema.exemplo.com.br
