# Obrigatórias: substitua antes de iniciar os containers.
DB_ROOT_PASSWORD=substitua-por-uma-senha-administrativa-segura
DB_PASSWORD=substitua-por-uma-senha-da-aplicacao-segura
JWT_SECRET=substitua-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Opcionais: os valores abaixo já são os padrões do Docker Compose.
# COMPOSE_PROJECT_NAME=inat-ead
# DB_NAME=inat_ead
# DB_USERNAME=inat_ead
# BACKEND_PORT=8080
# FRONTEND_PORT=3000

# URL pública do sistema acessado pelos CTAs da landing page.
# Sem valor, os links continuam apontando para a seção local.
# NEXT_PUBLIC_INTERNAL_SYSTEM_URL=https://sistema.exemplo.com.br
